{
	admin off
	persist_config off
	auto_https off

	{$CADDY_GLOBAL_OPTIONS}

	log {
		format json
		output stderr
		level INFO
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {
	root * /app/public

	encode zstd br gzip

	header X-Content-Type-Options "nosniff"

	@dotfiles {
		path_regexp (^|/)\.
		not path /.well-known/*
	}
	respond @dotfiles 403

	@viteAssets path /build/*
	header @viteAssets Cache-Control "public, max-age=2592000, immutable"

	@storageAssets path /storage/*
	header @storageAssets Cache-Control "public, max-age=2592000, immutable"

	file_server {
		hide .git
		hide .env*
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
