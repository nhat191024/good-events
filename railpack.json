{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "packages": {
        "node": "22"
    },
    "deploy": {
        "aptPackages": [
            "...",
            "supervisor",
            "openssh-client",
            "wget"
        ]
    },
    "steps": {
        "extensions": {
            "commands": [
                "...",
                "install-php-extensions zip pdo_mysql gd bcmath intl pcntl exif opcache imagick redis"
            ]
        },
        "build": {
            "commands": [
                "php -v",
                "npm run build:ssr"
            ]
        }
    }
}
