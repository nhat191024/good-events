meta {
  name: send video
  type: http
  seq: 5
}

post {
  url: {{url}}chat/threads/{{thread_id}}/messages
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  thread_id: 27
  upload_path: C:/path/to/sample.mp4
}

body:multipart-form {
  type: video
  video: @file({{upload_path}})
  ~body: Nội dung đính kèm
  ~client_message_id: 4628c783-537a-412f-b9ad-28ccf4046c0f
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Chọn thread_id và upload_path trước khi gửi. Mỗi tin nhận đúng một video.
  Giới hạn 50 MB (51200 KB), kiểm tra đuôi và MIME từ nội dung.
  Bật client_message_id và giữ nguyên UUID để kiểm tra retry không tạo trùng.
  Kiểm tra thiếu tệp, sai MIME, vượt dung lượng và tài khoản ngoài phòng.
}
